/* Estilos específicos da home */
.box-page {
  display: flex;
  flex-direction: column;
  gap: var(--sp-md);
}

.page-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-md);
  width: 100%;
}

.page-item {
  flex: 1;
  min-width: 200px;
  width: 100%;
}

@media (max-width: 1880px) {
  .page-item {
    flex-basis: 100%;
  }
}

.min-h-screen {
  min-height: 100vh;
}

.max-w-4xl {
  max-width: var(--sp-4xl);
}

.bg-gray-800\/50 {
  background-color: rgba(31, 41, 55, 0.5);
}

.backdrop-blur-sm {
  backdrop-filter: blur(4px);
}

.text-white {
  color: white;
}

.text-gray-500 {
  color: var(--color-text-gray-500);
}

.box-conteiner-dados {
  padding-left: 1rem;
  padding-right: 1rem;
  padding-top: 1rem;
  padding-bottom: 1rem;
  color: var(--color-text-primary);
  border-radius: 0.5rem;
  border-width: 1px;
  border-color: var(--color-atributos-item-border);
  background-color: var(--color-atributos-item-background);
  display: flow-root;
  gap: 16px;
  width: 100%;
}

.box-conteiner-search {
  border-top-left-radius: 28px;
  border-top-right-radius: 28px;
  border-bottom-left-radius: 1rem;
  border-bottom-right-radius: 1rem;
  padding-left: 0.2rem;
  padding-right: 0.2rem;
  padding-top: 0.2rem;
  padding-bottom: 0.2rem;
  color: var(--color-text-primary);
  border-width: 1px;
  border-color: var(--color-border-search);
  background-color: var(--color-background-search);
  border: 1px solid var(--color-border-search);
  display: flex;
  flex-direction: column;
  gap: var(--sp-sm);
}

.shadow-input {
  --tw-shadow: 0 40px 50px 5px rgba(0, 0, 0, 0.4),
    0 4px 6px -4px rgb(0 0 0 / 0.5);
  --tw-shadow-colored: 0 50px 25px -3px var(--tw-shadow-color),
    0 4px 6px -4px var(--tw-shadow-color);
  box-shadow: var(--tw-ring-offset-shadow, 0 2 #0000),
    var(--tw-ring-shadow, 0 2 #0000), var(--tw-shadow);
  border-radius: 100%;
}

.page {
  display: flex;
  width: 100%;
  min-height: 100vh;
  position: relative;
  justify-content: center;
  padding: 0;
  transition: all 0.5s cubic-bezier(0.215, 0.61, 0.355, 1);
  overflow-y: auto;
}

.page.with-sidebar {
  margin-right: 420px;
}

.content {
  flex: 1;
  width: 100%;
  transition: all 0.5s cubic-bezier(0.215, 0.61, 0.355, 1);
  position: relative;
  z-index: 1;
}

.container {
  width: 100%;
  padding: 0 48px;
  max-width: 100%;
  margin: 0 auto;
}

@media (max-width: 1200px) {
  .page {
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 0;
  }

  .container {
    padding: 0 24px;
  }
}
  .container {
    padding: 0 24px;
  }
