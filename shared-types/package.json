    "eslint": "^8.38.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.4",
    "vitest": "^0.31.4"
  },
  "dependencies": {
    "update": "^0.7.4",
    "zod": "^3.24.2"
