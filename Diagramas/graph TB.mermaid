---
config:
  theme: redux-dark
  look: neo
  layout: elk
---
flowchart TB
    subgraph "Frontend (deepsearch-ui-nexcode)"
        UI[Interface do Usuário]
        Input[Input de Mensagem]
        APIKey[Gerenciamento de API Key]
        FileUpload[Upload de Arquivos]
    end

    subgraph "Backend (Servidor)"
        API[API Endpoint]
        Auth[Autenticação]
        TokenTracker[Token Tracker]
        ActionTracker[Action Tracker]
    end

    subgraph "Processamento"
        Agent[Agente de Pesquisa]
        Search[Serviço de Busca]
        LLM[Modelo de Linguagem]
        Tools[Ferramentas]
    end

    subgraph "Ferramentas Disponíveis"
        %% Ferramentas Base
        Browser[Browser Tool]
        SearchTool[Search Tool]
        CodeTool[Code Tool]
        ReflectTool[Reflect Tool]

        %% Bridge MCP
        MCPBridge[MCP Bridge]
        MCPRunner[MCP Runner]
        MCPAgent[MCP Agent]

        %% MCP Server
        MCPServer[MCP Server]
    end

    subgraph "Navegador-main Tools"
        MCPTools[Tool Collection]

        subgraph "Ferramentas Sistema"
            Bash[bash.py]
            Terminal[terminal.py]
            PythonExec[python_execute.py]
            FileOps[file_operators.py]
            FileSaver[file_saver.py]
            StrReplace[str_replace_editor.py]
        end

        subgraph "Ferramentas Navegação"
            BrowserTool[browser_use_tool.py]
            WebSearch[web_search.py]
        end

        subgraph "Ferramentas IA"
            ChatCompletion[create_chat_completion.py]
            Planning[planning.py]
        end

        subgraph "Ferramentas Controle"
            MCPControl[mcp.py]
            Terminate[terminate.py]
            ToolCollectionMgr[tool_collection.py]
        end
    end

    subgraph "Loop de Pesquisa"
        Think[Processo de Pensamento]
        SearchLoop[Loop de Busca]
        URLVisit[Visita de URLs]
        Knowledge[Acúmulo de Conhecimento]
    end

    %% Fluxo Principal
    UI -->|1. Envia Pergunta| Input
    Input -->|2. Valida API Key| APIKey
    APIKey -->|3. Envia Requisição| API
    API -->|4. Autentica| Auth
    Auth -->|5. Inicializa Trackers| TokenTracker
    TokenTracker -->|6. Processa| Agent

    %% Processamento do Agente
    Agent -->|7.1 Escolhe Ferramenta| Tools
    Tools -->|7.2 Executa Ação| SearchLoop
    SearchLoop -->|8.1 Busca| Search
    SearchLoop -->|8.2 Visita URLs| URLVisit
    SearchLoop -->|8.3 Acumula Conhecimento| Knowledge
    Knowledge -->|9.1 Atualiza Pensamento| Think
    Think -->|10.1 Decide Próxima Ação| Agent

    %% Retorno ao Usuário
    Agent -->|11. Stream de Resposta| API
    API -->|12. Atualiza UI| UI

    %% Fluxo de Ferramentas
    Tools -->|13.1 Browser| Browser
    Tools -->|13.2 Search| SearchTool
    Tools -->|13.3 Code| CodeTool
    Tools -->|13.4 Reflect| ReflectTool
    Tools -->|13.5 MCP| MCPBridge

    %% Bridge para MCP
    MCPBridge -->|Bridge 1. Inicializa| MCPRunner
    MCPRunner -->|Bridge 2. Registra| MCPAgent
    MCPAgent -->|Bridge 3. Conecta| MCPServer
    MCPServer -->|Bridge 4. Acessa| MCPTools

    %% Acesso às ferramentas do Navegador-main
    MCPTools -->|Ferramentas 1. Sistema| Bash
    MCPTools -->|Ferramentas 1. Sistema| Terminal
    MCPTools -->|Ferramentas 1. Sistema| PythonExec
    MCPTools -->|Ferramentas 1. Sistema| FileOps
    MCPTools -->|Ferramentas 1. Sistema| FileSaver
    MCPTools -->|Ferramentas 1. Sistema| StrReplace

    MCPTools -->|Ferramentas 2. Navegação| BrowserTool
    MCPTools -->|Ferramentas 2. Navegação| WebSearch

    MCPTools -->|Ferramentas 3. IA| ChatCompletion
    MCPTools -->|Ferramentas 3. IA| Planning

    MCPTools -->|Ferramentas 4. Controle| MCPControl
    MCPTools -->|Ferramentas 4. Controle| Terminate
    MCPTools -->|Ferramentas 4. Controle| ToolCollectionMgr

    %% Decisão de Ferramenta
    Agent -->|14.1 Analisa Contexto| Think
    Think -->|14.2 Escolhe Ferramenta| Tools
    Tools -->|14.3 Executa| SearchLoop

    %% Monitoramento
    TokenTracker -->|15.1 Monitora Tokens| Agent
    ActionTracker -->|15.2 Monitora Ações| Agent
