{
  "mcpServers": {
    "api200": {
      "command": "npx",
      "args": ["api200-mcp@latest"],
      "env": {
        "USER_KEY": "92364ffa2d02f1163d793126026d3785"
      },
      "alwaysAllow": [
        "get_v1_models",
        "get_v1_models_by_model",
        "post_api_v1_ncm",
        "get_api_v1_logs",
        "get_api_v1_logs_stream",
        "post_api_v1_query",
        "get_api_v1_stream_by_requestId",
        "get_api_v1_task_by_requestId",
        "get_api_v1_queries",
        "get_api_v1_knowledge_by_id",
        "get_health"
      ]
    },
    "navegador": {
      "command": "python3",
      "args": ["${NAVEGADOR_MCP_PATH}"],
      "env": {
        "MCP_AUTH_TOKEN": "${MCP_AUTH_TOKEN}",
        "MCP_SERVER_URL": "${MCP_SERVER_URL}"
      }
    }
  },
  "auth": {
    "type": "multi",
    "providers": {
      "api_key": {
        "type": "header",
        "name": "x-api-key",
        "location": "config/api-keys.json"
      },
      "mcp": {
        "type": "token",
        "name": "MCP_AUTH_TOKEN",
        "envVar": true
      }
    }
  }
}
